{
  "manifest_version": 3,
  "name": "Prism Claude Usage Sync",
  "version": "1.1.0",
  "description": "Automatically send Claude subscription quota to your local Prism widget. No tokens or conversation data leave the browser.",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}